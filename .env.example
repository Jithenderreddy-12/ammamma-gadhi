# Copy to .env — NEVER commit a real .env (it is gitignored).
# Local dev: leave DATABASE_URL blank to use SQLite (data/pickles.db).
# Prod / docker-compose: set DATABASE_URL to Postgres.
PORT=3000
DATABASE_URL=
DB_PATH=./data/pickles.db

# Razorpay TEST mode (https://dashboard.razorpay.com/app/keys)
# Get test keys, paste them here. With no keys the app runs in MOCK mode:
# it creates fake order_mock_* ids so you can test the full flow end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Set to "true" only when you really want live Razorpay calls in dev.
# RAZORPAY_LIVE=false
